# 데이터베이스 설정
MYSQL_ROOT_PASSWORD=rootpassword
MYSQL_DATABASE=ocare_db
MYSQL_USER=ocare_user
MYSQL_PASSWORD=ocare_password
MYSQL_PORT=3306

# Redis 설정
REDIS_PORT=6379

# 애플리케이션 설정
APP_PORT=8080
SPRING_PROFILES_ACTIVE=docker
JPA_DDL_AUTO=update
JPA_SHOW_SQL=false
JAVA_OPTS=-Xms512m -Xmx1024m

# 관리 도구 포트 (선택사항)
PHPMYADMIN_PORT=8081
REDIS_COMMANDER_PORT=8082